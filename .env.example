# Copie para .env.local (ignorado pelo git) e preencha.
#
# Os valores ficam no painel do Supabase → Project Settings → API.
# Sem eles, services/supabase.ts lança erro já no import e o app não abre.

# URL do projeto, ex.: https://<ref>.supabase.co
# (o <ref> também é o --project-id do `supabase gen types`)
EXPO_PUBLIC_SUPABASE_URL=

# Chave "anon" (pública). Pode ir para o app: quem protege os dados é o RLS.
# NUNCA coloque aqui a chave service_role — ela ignora o RLS, e tudo o que
# começa com EXPO_PUBLIC_ é embutido no app. Ela só existe nas Edge Functions.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Builds do EAS (eas build) não leem este arquivo: o .env.local fica de fora
# do upload. Cadastre as mesmas variáveis em expo.dev → projeto →
# Environment variables, marcando os três ambientes (development, preview e
# production), com visibilidade "Plain text" ou "Sensitive".
